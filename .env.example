# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the client. Used by ingestion + API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- SLAB API (Phase 0: not yet available — mock is used until this is set) ---
# When set, the real SLAB client is used instead of the mock.
SLAB_API_BASE_URL=
SLAB_API_KEY=

# --- 감액 Google Sheets (Phase 3) ---
WRITEOFF_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- OpenAI (Phase 2 등기부 OCR: gpt-4.1 · 챗봇/감액 해석·판단: gpt-4.1-mini) ---
OPENAI_API_KEY=
